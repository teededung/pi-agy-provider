{
  "name": "pi-agy-provider",
  "version": "1.1.14",
  "description": "Use Antigravity (agy) models inside the pi coding agent via the agy stream-json RPC, with pi as the UI.",
  "type": "module",
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "antigravity",
    "agy",
    "gemini"
  ],
  "author": "teededung",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teededung/pi-agy-provider.git"
  },
  "homepage": "https://github.com/teededung/pi-agy-provider#readme",
  "bugs": {
    "url": "https://github.com/teededung/pi-agy-provider/issues"
  },
  "files": [
    "index.ts",
    "lib",
    "src",
    "extensions",
    "skills",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts",
      "./extensions/btw.ts"
    ],
    "skills": [
      "./skills"
    ],
    "image": "https://cdn.jsdelivr.net/gh/teededung/pi-agy-provider@main/assets/agy-usage.png"
  },
  "dependencies": {
    "effect": "4.0.5",
    "proper-lockfile": "4.1.2",
    "semver": "^7.8.5",
    "which": "^7.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.2",
    "@types/proper-lockfile": "4.1.4",
    "@types/semver": "^7.8.0",
    "@types/which": "^3.0.4",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "check": "tsc --noEmit -p .",
    "test": "node --test --experimental-strip-types test/*.test.ts"
  }
}
